# Copy to .env and fill in. .env is never committed.

# Hugging Face token: needed only to DOWNLOAD gated models (e.g. Cohere
# Transcribe) once. Running already-downloaded models needs no token.
HF_TOKEN=

# Where downloaded models are stored (move to a disk with more space).
# HF_HOME=/percorso/con/spazio/huggingface

# Optional: transcriber ensemble (comma-separated), default per tier.
# AKOE_ASR_ENSEMBLE=cohere,qwen3,parakeet,whisper
